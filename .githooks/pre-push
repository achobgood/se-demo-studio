#!/bin/bash
# Blocks a push when scripts/check-repo.sh finds a problem. Enable once: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! scripts/check-repo.sh > /dev/null 2>&1; then
  echo "Push blocked: repo checks failed. Run scripts/check-repo.sh to see what failed." >&2
  exit 1
fi
