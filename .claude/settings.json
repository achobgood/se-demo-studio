{
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./jobs/*/.chrome-profile/**)"
    ],
    "allow": [
      "Bash(scripts/setup.sh)",
      "Bash(scripts/check-openrouter.sh)",
      "Bash(scripts/new-job.sh *)",
      "Bash(scripts/chrome.sh *)",
      "Bash(scripts/fetch-cisco-source.sh *)",
      "Bash(python3 lib/*)",
      "Bash(node capture/*)",
      "Bash(node build/render.js *)",
      "Bash(build/render_par.sh *)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s -m * http://127.0.0.1:*)",
      "Bash(cd jobs/*)",
      "Bash(ls *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(wc *)",
      "Bash(rm -rf out/chunks*)",
      "Bash(rm -rf capture/rec/*)",
      "Bash(rm -rf assets/clips/*)",
      "Bash(python3 -m json.tool *)",
      "mcp__claude-in-chrome__*"
    ],
    "defaultMode": "acceptEdits"
  }
}